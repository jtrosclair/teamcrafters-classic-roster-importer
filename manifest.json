{
  "manifest_version": 3,
  "name": "TeamCrafters Classic Roster Importer",
  "short_name": "Classic Roster Importer",
  "version": "0.6.1",
  "author": "TeamCrafters",
  "description": "By TeamCrafters. Copy classic, custom, or Team Builder directory rosters from TeamCrafters, or an EA Team Builder preview, then load them as an \"Import from TeamCrafters\" preset.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.ea.com/games/ea-sports-college-football/team-builder/*",
    "https://www.teamcrafters.net/app/classic-rosters/*",
    "https://teamcrafters.net/*",
    "https://www.teamcrafters.net/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/games/ea-sports-college-football/team-builder/*"
      ],
      "js": [
        "uniform-config.js",
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ea.com/games/ea-sports-college-football/team-builder/*"
      ],
      "js": [
        "csv-import.js",
        "csv-export.js",
        "ea-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.teamcrafters.net/app/classic-rosters/*"
      ],
      "js": [
        "roster-merge.js",
        "csv-import.js",
        "csv-export.js",
        "teamcrafters-copy.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.teamcrafters.net/app/customTeams/*"
      ],
      "js": [
        "roster-merge.js",
        "csv-import.js",
        "csv-export.js",
        "teamcrafters-copy.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.teamcrafters.net/app/teambuilder/CFB27/*"
      ],
      "js": [
        "roster-merge.js",
        "csv-import.js",
        "csv-export.js",
        "teamcrafters-copy.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.teamcrafters.net/cfb27/team-builder-unleashed",
        "https://www.teamcrafters.net/cfb27/team-builder-unleashed/",
        "http://localhost/cfb27/team-builder-unleashed",
        "http://localhost/cfb27/team-builder-unleashed/"
      ],
      "js": [
        "equipment-web-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "base-template/roster.json",
        "base-template/character_visuals.json",
        "reference/portrait-catalog.json"
      ],
      "matches": [
        "https://www.teamcrafters.net/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
